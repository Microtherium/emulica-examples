LVGL_INCLUDES := -I../Core/Inc -I$(LVGL_DIR) -I../Drivers/STM32F4xx_HAL_Driver/Inc -I../Drivers/STM32F4xx_HAL_Driver/Inc/Legacy -I../Drivers/CMSIS/Device/ST/STM32F4xx/Include -I../Drivers/CMSIS/Include

# Each subdirectory must supply rules for building sources it contributes.
# A single generic pattern rule (rather than one CubeIDE-style rule per file)
# is enough since every LVGL file compiles with the same flags; @mkdir -p
# creates each output subdirectory on demand since none are pre-created.
Middlewares/Third_Party/lvgl/%.o Middlewares/Third_Party/lvgl/%.su Middlewares/Third_Party/lvgl/%.cyclo: $(LVGL_DIR)/%.c Middlewares/Third_Party/lvgl/subdir.mk
