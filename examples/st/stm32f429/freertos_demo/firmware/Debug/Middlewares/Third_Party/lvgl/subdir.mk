################################################################################
# Hand-written, script-generated build fragment for the vendored LVGL v8.3.11
# library. CubeIDE's generated build enumerates every source file literally
# per-directory (see e.g. Core/Src/subdir.mk) rather than globbing - matching
# that convention (instead of a $(shell find ...) - based OBJS list) is
# required so project_runner.py's _ensure_objects_list() regex-based OBJS
# scraper (which reads literal "OBJS += ..." text, not expanded Make
# variables) can find these object paths too. This file is generated by
# scripts - do not add individual LVGL files by hand; regenerate instead if
# LVGL is upgraded or files are added/removed.
################################################################################
# LVGL v8.3.11 is not vendored in this project: the Emulica VS Code
# extension installs one shared copy (sidebar "Set up your tools" -> LVGL,
# or "Emulica Emulator: Check Required Tools") and exports its location as
# EMULICA_LVGL_DIR. Keeping it in a short folder outside the project keeps
# LVGL's deeply nested relative includes under Windows' 260-char path limit,
# which the in-project copy crossed for long Windows user names. Building
# outside the extension: pass LVGL_DIR=<path to an unpacked lvgl-8.3.11>.
LVGL_DIR ?= $(subst \,/,$(EMULICA_LVGL_DIR))
ifeq ($(strip $(LVGL_DIR)),)
$(error LVGL 8.3.11 not found - install it from the Emulica sidebar ("Set up your tools"), or pass LVGL_DIR=<path to lvgl-8.3.11> to make)
endif


